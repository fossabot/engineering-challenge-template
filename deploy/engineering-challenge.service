[Unit]
Description=Engineering Challenge Order Book Collector
Documentation=https://github.com/your-org/engineering-challenge
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=collector
Group=collector

# Binary and config
ExecStart=/usr/local/bin/engineering-challenge --config /etc/engineering-challenge/settings.toml
ExecReload=/bin/kill -HUP $MAINPID

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Capabilities (minimal)
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Resources
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=4G
CPUQuota=200%

# Output and state directories
ReadWritePaths=/var/lib/engineering-challenge /var/log/engineering-challenge
StateDirectory=engineering-challenge
LogsDirectory=engineering-challenge
CacheDirectory=engineering-challenge

# Restart policy
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=3

# Environment
Environment=RUST_LOG=info
Environment=RUST_BACKTRACE=1

# Health checks via HTTP
# Note: Type=notify means the process must call sd_notify(READY=1)
# The collector does not currently implement sd_notify; use Type=simple
# and rely on readiness endpoint for orchestration.
# Type=simple

[Install]
WantedBy=multi-user.target