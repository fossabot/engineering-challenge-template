[Unit]
Description=Engineering Challenge Order Book Collector
Documentation=https://github.com/your-org/engineering-challenge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=collector
Group=collector

# Binary and config
ExecStart=/usr/local/bin/engineering-challenge --config /etc/engineering-challenge/settings.toml

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Capabilities (minimal)
CapabilityBoundingSet=

# Resources
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=4G
CPUQuota=200%

# Output and state directories
ReadWritePaths=/var/lib/engineering-challenge /var/log/engineering-challenge
StateDirectory=engineering-challenge
LogsDirectory=engineering-challenge
CacheDirectory=engineering-challenge

# Restart policy
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=3

# Environment
Environment=RUST_LOG=info
Environment=RUST_BACKTRACE=1

# Health checks via HTTP are exposed at /readyz. systemd starts the process;
# an orchestrator should wait for that endpoint before routing traffic.

[Install]
WantedBy=multi-user.target
